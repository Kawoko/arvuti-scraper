# ---------------------------------------------------------------------------
# Arvutitark Price Tracker - environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and MUST NEVER be committed.
# ---------------------------------------------------------------------------

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Safe for browser use, read-only thanks to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SECRET key (service role). SERVER-SIDE ONLY.
# NEVER prefix this with NEXT_PUBLIC_ and NEVER send it to the browser.
SUPABASE_SECRET_KEY=your-secret-key

# ---------------------------------------------------------------------------
# Scraper configuration (server-side only)
# ---------------------------------------------------------------------------

# Arvutitark JSON products endpoint.
ARVUTITARK_BASE_URL=https://cms.arvutitark.ee/api/products

# Per-request timeout in milliseconds.
ARVUTITARK_REQUEST_TIMEOUT_MS=20000

# Delay between paginated requests (politeness). Milliseconds.
ARVUTITARK_PAGE_DELAY_MS=750

# Hard ceiling on pages fetched, to fail fast if the API misbehaves.
ARVUTITARK_MAX_PAGES=50

# Verbose scraper logging: request URL, HTTP status, pagination metadata.
# Never logs credentials. Leave unset or false for normal operation.
# SCRAPER_DEBUG=true

# Override the graphics card attribute filter. Defaults to 16 GB VRAM plus the
# tracked chipset whitelist. Set to 15[16] to drop the chipset filter if it ever
# stops matching; off-list models are then rejected locally instead.
# ARVUTITARK_GPU_ATTRIBUTES=15[16]
